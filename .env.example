# No environment variables are required for SadoAI 1.0.
# Optional: URL for a self-hosted copy of Google's Gesture Recognizer model.
# NEXT_PUBLIC_GESTURE_MODEL_URL=/vision/gesture_recognizer.task

# Optional: serve Google's Holistic Landmarker asset from your own origin.
# NEXT_PUBLIC_HOLISTIC_MODEL_URL=/vision/holistic_landmarker.task
# Leave unset until a documented Uzbek Sign Language model passes independent evaluation.
# NEXT_PUBLIC_UZ_SIGN_MODEL_URL=/vision/uz-sign-v1.json

# Optional and server-only. Use an HTTPS receiver you control.
# FEEDBACK_WEBHOOK_URL=https://your-receiver.example/feedback
# FEEDBACK_WEBHOOK_TOKEN=
